{
  "name": "@devscholar/node-ps1-dotnet",
  "version": "0.0.12",
  "description": "Node.js to .NET interop via IPC",
  "main": "./dist/index.js",
  "type": "module",
  "files": [
    "dist",
    "types",
    "scripts"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./types/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node start.js"
  },
  "keywords": [
    "dotnet",
    "winforms",
    "wpf",
    "webview2",
    "netfx",
    "deno",
    "bun",
    "gui"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.0.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
